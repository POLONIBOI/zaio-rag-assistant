        "completionTitle": "Not in the knowledge base",
        "completionMessage": "={{ $('Read the reply').item.json.answer }}\n\nIt isn't in the student handbook or on zaio.io. Ask your tutor on Discord, or email hello@zaio.io.",
        "options": {}
      },
      "id": "23a95dfc-b6ff-4000-a6c5-129a4596a619",
