            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "33ef9ed9-3177-43d8-9077-a8f01fa461b5",
              "leftValue": "={{ $('Settings').item.json.discordWebhookUrl }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "56769a81-2ee5-47eb-972b-2912778ff99a",
      "name": "Discord webhook set?",
