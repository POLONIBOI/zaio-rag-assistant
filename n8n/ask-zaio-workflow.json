      "typeVersion": 2.2,
      "position": [
        1480,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').item.json.discordWebhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: 'Zaio assistant', content: 'A student asked something the assistant could not answer from the handbook or zaio.io:\\n> ' + $('Read the reply').item.json.question }) }}",
        "options": {}
      },
      "id": "c931bf77-b093-4283-9c57-6af43ee64ad0",
