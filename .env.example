# Copy to .env and fill in. Get a key at https://console.anthropic.com
# Leave it empty to use the free local model instead.
ANTHROPIC_API_KEY=

# Optional overrides
# LLM_PROVIDER=auto          # auto | claude | local
# CLAUDE_MODEL=claude-opus-5
# LOCAL_MODEL=Qwen/Qwen3-0.6B
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # empty = no reranking
# MIN_SIMILARITY=0.25
# HANDBOOK_PATH=data/handbook.pdf
# WEBSITE_PAGES_PATH=data/website/pages.json
